<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickOTP.Console</AssemblyName>
    <RootNamespace>QuickOTP.Console</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="TextCopy" />
    <ProjectReference Include="../QuickOTP.Core/QuickOTP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Terminal.Gui" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="../QuickOTP.Core/**/*.cs" />
    <Compile Remove="../QuickOTP.Popup/**/*.cs" />
    <Compile Remove="../QuickOTP.Editor/**/*.cs" />
  </ItemGroup>

</Project>
