<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickOTP.Editor.ViewModels"
        xmlns:controls="clr-namespace:QuickOTP.Editor.Controls"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="QuickOTP.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QuickOTP Vault"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}">

    <Grid>
        <Grid ColumnDefinitions="320,*">
            <!-- Instrument rail -->
            <Border Background="{DynamicResource HarborBrush}" Padding="22,24">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="QuickOTP"
                                   FontSize="12"
                                   LetterSpacing="3"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BezelSoftBrush}" />
                        <TextBlock Text="Vault"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RailTextBrush}" />
                        <TextBlock Text="Edit, import, and keep your authenticator accounts."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource RailMistBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,12" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="ghost"
                                Content="Import"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="2FAS backup…" Click="OnImport2FasClick" />
                                    <MenuItem Header="JSON backup…" Click="OnImportJsonClick" />
                                    <MenuItem Header="Authenticator URI…" Command="{Binding OpenUriImportCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="Export"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="2FAS backup…" Click="OnExport2FasClick" />
                                    <MenuItem Header="Encrypted 2FAS backup…" Click="OnExport2FasEncryptedClick" />
                                    <MenuItem Header="JSON backup…" Click="OnExportJsonClick" />
                                    <MenuItem Header="JSON backup (this device only)…" Click="OnExportJsonEncryptedClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBox x:Name="SearchBox"
                                 Watermark="Search or paste otpauth://"
                                 Text="{Binding SearchText}"
                                 Background="{DynamicResource HarborRaisedBrush}"
                                 Foreground="{DynamicResource RailTextBrush}"
                                 BorderBrush="#334859"
                                 CaretBrush="{DynamicResource BezelSoftBrush}" />
                        <Button Classes="ghost"
                                Content="Import this authenticator link"
                                IsVisible="{Binding SearchLooksLikeUri}"
                                Command="{Binding ImportSearchUriCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,14,0,14">
                        <ListBox x:Name="AccountsList"
                                 ItemsSource="{Binding FilteredAccounts}"
                                 SelectedItem="{Binding SelectedAccount, Mode=OneWay}"
                                 SelectionChanged="OnAccountSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border">
                                    <Setter Property="Background" Value="{DynamicResource HarborSelectedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BezelBrush}" />
                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountItemViewModel">
                                    <Border Background="{DynamicResource HarborRaisedBrush}"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <controls:PeriodRing Grid.Row="0"
                                                                 Grid.RowSpan="2"
                                                                 Width="36"
                                                                 Height="36"
                                                                 Margin="0,0,12,0"
                                                                 StrokeThickness="4"
                                                                 Progress="{Binding Progress}"
                                                                 IsUrgent="{Binding IsUrgent}"
                                                                 VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Issuer}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RailTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding AccountName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource RailMistBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       Text="{Binding FormattedCode}"
                                                       FontFamily="{DynamicResource CodeFont}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BezelSoftBrush}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="2"
                                                       Text="{Binding RemainingLabel}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource RailMistBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No matching accounts"
                                   IsVisible="{Binding ShowNoMatches}"
                                   Foreground="{DynamicResource RailMistBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button Grid.Row="4"
                            Classes="ghost"
                            Content="+ New account"
                            Command="{Binding NewAccountCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- Work desk -->
            <Border Grid.Column="1" Background="{DynamicResource FogBrush}">
                <Grid>
                    <Grid Margin="36,32" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowEditor}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding EditorTitle}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Changes stay on this device until you export a backup."
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MistBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="quiet"
                                    Content="Copy code"
                                    Command="{Binding CopyCodeCommand}"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,24,0,16">
                            <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                                <StackPanel Spacing="16">
                                    <Border Background="{DynamicResource HarborBrush}"
                                            CornerRadius="28"
                                            Padding="28,24"
                                            HorizontalAlignment="Left">
                                        <Grid Width="220" Height="220">
                                            <controls:PeriodRing Width="220"
                                                                 Height="220"
                                                                 StrokeThickness="10"
                                                                 Progress="{Binding LiveProgress}"
                                                                 IsUrgent="{Binding IsLiveUrgent}" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding FormattedLiveCode}"
                                                           FontFamily="{DynamicResource CodeFont}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BezelSoftBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding LiveRemainingLabel}"
                                                           FontSize="11"
                                                           Width="150"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource RailMistBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding CodeHint}"
                                               IsVisible="{Binding HasCodeHint}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="12" />

                                    <TextBlock Text="Issuer" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" />
                                    <TextBox Text="{Binding EditIssuer}" Watermark="GitHub, Google, bank…" />

                                    <TextBlock Text="Account" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" />
                                    <TextBox Text="{Binding EditName}" Watermark="you@example.com" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Secret" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Classes="link"
                                                Content="{Binding SecretVisibilityLabel}"
                                                Command="{Binding ToggleSecretVisibilityCommand}" />
                                    </Grid>
                                    <TextBox Text="{Binding EditSecret}"
                                             Watermark="Base32 secret"
                                             PasswordChar="{Binding SecretMaskChar}"
                                             FontFamily="{DynamicResource CodeFont}" />

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Algorithm" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding AlgorithmOptions}" SelectedItem="{Binding EditAlgorithm}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Digits" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding DigitOptions}" SelectedIndex="{Binding DigitSelectedIndex}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Period" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedIndex="{Binding PeriodSelectedIndex}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock Text="QR" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MistBrush}" />
                                    <Border Background="{DynamicResource FoamBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16">
                                        <Panel Height="180">
                                            <Image Source="{Binding QrImage}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="A QR appears when the secret is valid."
                                                       IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                       Foreground="{DynamicResource MistBrush}"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="Scan this with another authenticator after you save."
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MistBrush}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                            <Button Classes="tide"
                                    Content="Save changes"
                                    Command="{Binding SaveCommand}" />
                            <TextBlock Grid.Column="1"
                                       Text="Unsaved changes"
                                       IsVisible="{Binding HasUnsavedChanges}"
                                       Foreground="{DynamicResource BezelBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />
                            <Button Grid.Column="2"
                                    Classes="danger"
                                    Content="Remove"
                                    Command="{Binding DeleteCommand}"
                                    IsVisible="{Binding CanDelete}" />
                        </Grid>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                MaxWidth="420"
                                IsVisible="{Binding ShowEmptyVault}">
                        <TextBlock Text="Your vault is empty"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Import a 2FAS or JSON backup, paste an otpauth:// link in search, or add an account by hand."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource MistBrush}" />
                        <Button Classes="tide"
                                Content="Add your first account"
                                Command="{Binding NewAccountCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding ShowEmptyEditor}">
                        <TextBlock Text="Select an account"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Or add a new one from the rail."
                                   Foreground="{DynamicResource MistBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border Background="{DynamicResource HarborBrush}"
                CornerRadius="12"
                Padding="16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                IsVisible="{Binding HasToast}"
                BoxShadow="0 12 32 0 #33000000">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource RailTextBrush}" />
        </Border>

        <!-- Overlay -->
        <Grid IsVisible="{Binding IsOverlayOpen}">
            <Border Background="#9913202C" />
            <Border Background="{DynamicResource FoamBrush}"
                    CornerRadius="18"
                    Padding="24"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 18 48 0 #44000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding OverlayTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="{Binding OverlayMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MistBrush}" />

                    <StackPanel Spacing="10" IsVisible="{Binding IsPasswordOverlay}">
                        <TextBox Text="{Binding PasswordInput}"
                                 PasswordChar="•"
                                 Watermark="Password" />
                        <TextBox Text="{Binding ConfirmPasswordInput}"
                                 PasswordChar="•"
                                 Watermark="Confirm password"
                                 IsVisible="{Binding OverlayRequiresPasswordConfirm}" />
                    </StackPanel>

                    <TextBox Text="{Binding UriInput}"
                             Watermark="otpauth://totp/…"
                             IsVisible="{Binding IsUriImportOverlay}" />

                    <CheckBox Content="Skip accounts that are already in this vault"
                              IsChecked="{Binding SkipDuplicates}"
                              IsVisible="{Binding IsImportPreviewOverlay}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button Classes="quiet"
                                Content="Cancel"
                                Command="{Binding CancelOverlayCommand}"
                                IsCancel="True"
                                HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="tide"
                                    Content="{Binding OverlayPrimaryLabel}"
                                    Command="{Binding ConfirmOverlayCommand}"
                                    IsVisible="{Binding IsConfirmOverlay}" />
                            <Button Classes="tide"
                                    Content="{Binding OverlayPrimaryLabel}"
                                    Command="{Binding SubmitPasswordCommand}"
                                    IsVisible="{Binding IsPasswordOverlay}" />
                            <Button Classes="tide"
                                    Content="{Binding OverlayPrimaryLabel}"
                                    Command="{Binding ConfirmImportCommand}"
                                    IsVisible="{Binding IsImportPreviewOverlay}" />
                            <Button Classes="tide"
                                    Content="{Binding OverlayPrimaryLabel}"
                                    Command="{Binding SubmitUriImportCommand}"
                                    IsVisible="{Binding IsUriImportOverlay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
